<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tele.app.tv">

    <!--
      Destino principal: Android TV. Se declara como "no obligatorio" para que
      el mismo APK se pueda instalar y abrir en una tablet o un telefono; la UI
      sigue siendo de 10-foot (foco / D-pad), no adaptada a tactil.
    -->
    <uses-feature
        android:name="android.hardware.type.television"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Visibilidad de paquetes para poder abrir apps de streaming oficiales
      (Filmin, Netflix, RTVE, etc.) directamente desde la ficha de detalle.
    -->
    <queries>
        <package android:name="com.filmin.androidtv" />
        <package android:name="com.filmin" />
        <package android:name="com.netflix.ninja" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.mubi" />
        <package android:name="com.rtve.alacarta" />
        <package android:name="com.movistar.androidtv" />
        <package android:name="com.apple.atve.androidtv.appletv" />
        <package android:name="com.wbd.stream" />
        <package android:name="com.hbo.hbonow" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".TeleTvApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:banner="@drawable/banner_tele"
        android:label="@string/app_name"
        android:theme="@style/Theme.TeleTv"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:screenOrientation="landscape">
            <!-- LEANBACK_LAUNCHER: launcher de Android TV -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- LAUNCHER: cajon de apps en tablet/telefono -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
